# --- Database (Neon Postgres, pooled connection string) ---
DATABASE_URL=

# --- Contact data (Apollo REST API) ---
APOLLO_API_KEY=

# --- Maps / measurement (Mapbox) ---
# A PUBLIC token (starts with "pk."), URL-restricted in the Mapbox dashboard.
# Used for satellite imagery, polygon drawing, and address geocoding. It is
# injected into the client to render the map, so never use a secret "sk." token.
MAPBOX_API=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Clerk) — not required yet; operator routes fall back to a shared
#     secret if these are unset. See middleware.ts TODO. ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
OPERATOR_SHARED_SECRET=

# --- Email (Resend) — not required until the outreach phase ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Nightly pipeline cron (Vercel sends `Authorization: Bearer $CRON_SECRET`
# to /api/cron/pipeline). Any long random string.
CRON_SECRET=

# White-label tenancy: tenants are served at <slug>.<TENANT_ROOT_DOMAIN>
# (e.g. acme.greenkeep.us). Unset = single-tenant (default company everywhere).
TENANT_ROOT_DOMAIN=

# --- Lead marketplace (buyer portal) ---
# HMAC secret for buyer claim/login/session tokens. Any long random string
# (falls back to CUSTOMER_AUTH_SECRET, then OPERATOR_SHARED_SECRET).
BUYER_AUTH_SECRET=
# Stripe: secret key + the webhook signing secret for /api/webhooks/stripe
# (subscribe the endpoint to `checkout.session.completed`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price per lead unlock in whole dollars (default 79).
LEAD_PRICE_USD=
